<?xml version="1.0"?>
<package format="3">
  <name>terrain_analysis</name>
  <version>0.1.0</version>
  <description>Bounded world-XY quantile terrain analysis with a portable C++ core.</description>
  <maintainer email="maintainers@example.invalid">Terrain Analysis Contributors</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
