<link name="front_right_wheel"><pose>0.25 -0.33 .14 0 0 0</pose><inertial><mass>2</mass><inertia><ixx>0.0108666666667</ixx><iyy>0.0196</iyy><izz>0.0108666666667</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
<collision name="front_right_collision"><pose>0 0 0 1.5707963267948966 0 0</pose><geometry><cylinder><radius>.14</radius><length>.08</length></cylinder></geometry></collision>
