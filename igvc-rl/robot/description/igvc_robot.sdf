<?xml version="1.0"?>
<sdf version="1.9"><model name="igvc_robot"><static>false</static><self_collide>false</self_collide>
<link name="base_link"><pose>0 0 .30 0 0 0</pose><inertial><mass>42</mass><inertia><ixx>1.4294</ixx><iyy>3.0044</iyy><izz>4.095</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
<collision name="chassis_collision"><geometry><box><size>.90 .60 .22</size></box></geometry></collision>
<visual name="chassis_visual"><geometry><box><size>.90 .60 .22</size></box></geometry></visual>
<sensor name="camera" type="camera"><pose>0 0 .8 0 .0934 0</pose><always_on>true</always_on><update_rate>10</update_rate><topic>/camera/image</topic><gz_frame_id>camera_link</gz_frame_id><camera><horizontal_fov>1.371</horizontal_fov><image><width>640</width><height>360</height><format>R8G8B8</format></image><clip><near>.05</near><far>100</far></clip></camera></sensor>
<sensor name="lidar" type="gpu_lidar"><pose>0 0 .3 0 0 0</pose><always_on>true</always_on><update_rate>10</update_rate><topic>/scan</topic><gz_frame_id>lidar_link</gz_frame_id><lidar><scan><horizontal><samples>640</samples><resolution>1</resolution><min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle></horizontal><vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan><range><min>.1</min><max>20</max><resolution>.01</resolution></range></lidar></sensor>
</link>
<link name="front_left_wheel"><pose>0.25 0.33 .14 0 0 0</pose><inertial><mass>2</mass><inertia><ixx>0.0108666666667</ixx><iyy>0.0196</iyy><izz>0.0108666666667</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
<collision name="front_left_collision"><pose>0 0 0 1.5707963267948966 0 0</pose><geometry><cylinder><radius>.14</radius><length>.08</length></cylinder></geometry></collision>
<visual name="front_left_visual"><pose>0 0 0 1.5707963267948966 0 0</pose><geometry><cylinder><radius>.14</radius><length>.08</length></cylinder></geometry></visual>
</link><joint name="front_left_joint" type="revolute"><parent>base_link</parent><child>front_left_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper><effort>100</effort><velocity>30</velocity></limit><dynamics><damping>.05</damping></dynamics></axis></joint>
<link name="rear_left_wheel"><pose>-0.25 0.33 .14 0 0 0</pose><inertial><mass>2</mass><inertia><ixx>0.0108666666667</ixx><iyy>0.0196</iyy><izz>0.0108666666667</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
