<link name="rear_right_wheel"><pose>-0.25 -0.33 .14 0 0 0</pose><inertial><mass>2</mass><inertia><ixx>0.0108666666667</ixx><iyy>0.0196</iyy><izz>0.0108666666667</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
