<?xml version="1.0"?>
<robot name="igvc_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
<link name="base_footprint"/>
<joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 .30"/></joint>
<link name="base_link"><inertial><mass value="42"/><inertia ixx="1.4294" iyy="3.0044" izz="4.095" ixy="0" ixz="0" iyz="0"/></inertial>
<collision><geometry><box size=".90 .60 .22"/></geometry></collision>
<visual><geometry><box size=".90 .60 .22"/></geometry></visual>
</link>
<link name="front_left_wheel"><inertial><mass value="2"/><inertia ixx="0.0108666666667" iyy="0.0196" izz="0.0108666666667" ixy="0" ixz="0" iyz="0"/></inertial>
<collision><origin rpy="1.5707963267948966 0 0"/><geometry><cylinder radius=".14" length=".08"/></geometry></collision>
<visual><origin rpy="1.5707963267948966 0 0"/><geometry><cylinder radius=".14" length=".08"/></geometry></visual>
</link><joint name="front_left_joint" type="continuous"><parent link="base_link"/><child link="front_left_wheel"/><origin xyz="0.25 0.33 -.16"/><axis xyz="0 1 0"/><limit effort="100" velocity="30"/><dynamics damping=".05"/></joint>
<link name="rear_left_wheel"><inertial><mass value="2"/><inertia ixx="0.0108666666667" iyy="0.0196" izz="0.0108666666667" ixy="0" ixz="0" iyz="0"/></inertial>
<collision><origin rpy="1.5707963267948966 0 0"/><geometry><cylinder radius=".14" length=".08"/></geometry></collision>
<visual><origin rpy="1.5707963267948966 0 0"/><geometry><cylinder radius=".14" length=".08"/></geometry></visual>
</link><joint name="rear_left_joint" type="continuous"><parent link="base_link"/><child link="rear_left_wheel"/><origin xyz="-0.25 0.33 -.16"/><axis xyz="0 1 0"/><limit effort="100" velocity="30"/><dynamics damping=".05"/></joint>
<link name="front_right_wheel"><inertial><mass value="2"/><inertia ixx="0.0108666666667" iyy="0.0196" izz="0.0108666666667" ixy="0" ixz="0" iyz="0"/></inertial>
<collision><origin rpy="1.5707963267948966 0 0"/><geometry><cylinder radius=".14" length=".08"/></geometry></collision>
<visual><origin rpy="1.5707963267948966 0 0"/><geometry><cylinder radius=".14" length=".08"/></geometry></visual>
</link><joint name="front_right_joint" type="continuous"><parent link="base_link"/><child link="front_right_wheel"/><origin xyz="0.25 -0.33 -.16"/><axis xyz="0 1 0"/><limit effort="100" velocity="30"/><dynamics damping=".05"/></joint>
<link name="rear_right_wheel"><inertial><mass value="2"/><inertia ixx="0.0108666666667" iyy="0.0196" izz="0.0108666666667" ixy="0" ixz="0" iyz="0"/></inertial>
<collision><origin rpy="1.5707963267948966 0 0"/><geometry><cylinder radius=".14" length=".08"/></geometry></collision>
<visual><origin rpy="1.5707963267948966 0 0"/><geometry><cylinder radius=".14" length=".08"/></geometry></visual>
</link><joint name="rear_right_joint" type="continuous"><parent link="base_link"/><child link="rear_right_wheel"/><origin xyz="-0.25 -0.33 -.16"/><axis xyz="0 1 0"/><limit effort="100" velocity="30"/><dynamics damping=".05"/></joint>
<link name="camera_link"/><joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0 0 0.8" rpy="0 0.0934 0"/></joint>
<link name="lidar_link"/><joint name="lidar_joint" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0 0 0.3" rpy="0 0 0"/></joint>
<!-- Gazebo uses the standalone SDF; these tags preserve equivalent sensors and drive configuration for URDF consumers. -->
<gazebo reference="base_link"><sensor name="camera" type="camera"><pose>0 0 .8 0 .0934 0</pose><always_on>true</always_on><update_rate>10</update_rate><topic>/camera/image</topic><gz_frame_id>camera_link</gz_frame_id><camera><horizontal_fov>1.371</horizontal_fov><image><width>640</width><height>360</height><format>R8G8B8</format></image><clip><near>.05</near><far>100</far></clip></camera></sensor>
<sensor name="lidar" type="gpu_lidar"><pose>0 0 .3 0 0 0</pose><always_on>true</always_on><update_rate>10</update_rate><topic>/scan</topic><gz_frame_id>lidar_link</gz_frame_id><lidar><scan><horizontal><samples>640</samples><resolution>1</resolution><min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle></horizontal><vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan><range><min>.1</min><max>20</max><resolution>.01</resolution></range></lidar></sensor></gazebo>
<gazebo><plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>front_left_joint</left_joint><left_joint>rear_left_joint</left_joint><right_joint>front_right_joint</right_joint><right_joint>rear_right_joint</right_joint><wheel_separation>.66</wheel_separation><wheel_radius>.14</wheel_radius><topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id><odom_publish_frequency>50</odom_publish_frequency><max_linear_velocity>1.5</max_linear_velocity><min_linear_velocity>-.3</min_linear_velocity><max_angular_velocity>1.5</max_angular_velocity><min_angular_velocity>-1.5</min_angular_velocity><max_linear_acceleration>.8</max_linear_acceleration><min_linear_acceleration>-1.2</min_linear_acceleration><max_angular_acceleration>2</max_angular_acceleration><min_angular_acceleration>-2</min_angular_acceleration></plugin></gazebo>
<gazebo><plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
  <odom_frame>world</odom_frame><robot_base_frame>base_link</robot_base_frame>
  <dimensions>2</dimensions><odom_publish_frequency>50</odom_publish_frequency>
  <odom_topic>/ground_truth/odom</odom_topic><tf_topic>/ground_truth/tf</tf_topic>
</plugin></gazebo>
</robot>
