<?xml version="1.0"?>
<!-- Gazebo GUI config intentionally uses sibling top-level elements. -->
<window>
  <width>960</width>
  <height>600</height>
</window>
<plugin filename="ImageDisplay" name="IGVC vehicle POV RGB">
  <gz-gui><title>IGVC vehicle POV RGB</title></gz-gui>
  <topic>/igvc_pov/camera/image</topic>
  <topic_picker>false</topic_picker>
</plugin>
